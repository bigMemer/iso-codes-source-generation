package __PACKAGE__.internal;

import __PACKAGE__.HistoryCheck;
import __PACKAGE__.HistoryPolicy;
import __PACKAGE__.HistoryState;
import __PACKAGE__.Match;
import __PACKAGE__.MeaningChangedException;
import __PACKAGE__.Relaxation;
import __PACKAGE__.Strictness;
import __PACKAGE__.UnknownCodeException;
import java.time.LocalDate;
import java.util.EnumSet;
import java.util.HashMap;
import java.util.Map;
import java.util.Objects;
import java.util.Optional;
import java.util.Set;

/**
 * Matches input against one code field, following the output specification's matching algorithm (§6.4), and checks
 * matches against history (§6.7).
 *
 * <p><b>Internal; not part of the API.</b> Public only so generated types in other packages can use it.
 *
 * @param <T> the entry type
 */
public final class Lookup<T> {

    /**
     * How to read an entry's history. Only the primary code field has one.
     *
     * @param <T> the entry type
     */
    public interface History<T> {
        /**
         * The entry's encoded timeline.
         *
         * @param entry the entry
         * @return the encoding
         */
        String timeline(T entry);

        /**
         * The earliest date the library has evidence for the entry's code.
         *
         * @param entry the entry
         * @return the date
         */
        LocalDate recordedSince(T entry);
    }

    private final String standard;
    private final String field;
    private final boolean numeric;
    private final Map<String, T> active;
    private final Map<String, T> withdrawn;
    private final Map<String, T> activeFolded = new HashMap<>();
    private final Map<String, T> withdrawnFolded = new HashMap<>();
    private final long introducedFirst;
    private final long introducedLast;
    private final History<T> history;

    /**
     * Creates a lookup.
     *
     * @param standard        the standard, e.g. {@code 3166-1}
     * @param field           the code field, e.g. {@code alpha_2}
     * @param numeric         whether the field is a numeric code, which enables {@link Relaxation#NUMERIC_PADDING}
     * @param active          every active entry by its canonical value for the field
     * @param withdrawn       withdrawn entries by value; where several share one, the most recently withdrawn
     * @param introducedFirst first possible day ISO published the field, as an epoch day
     * @param introducedLast  last possible day ISO published the field, as an epoch day
     * @param history         how to read entries' history, or null if the field has none
     */
    public Lookup(String standard, String field, boolean numeric, Map<String, T> active, Map<String, T> withdrawn,
            long introducedFirst, long introducedLast, History<T> history) {
        this.standard = standard;
        this.field = field;
        this.numeric = numeric;
        this.active = Map.copyOf(active);
        this.withdrawn = Map.copyOf(withdrawn);
        active.forEach((value, entry) -> activeFolded.put(asciiUpper(value), entry));
        withdrawn.forEach((value, entry) -> withdrawnFolded.put(asciiUpper(value), entry));
        this.introducedFirst = introducedFirst;
        this.introducedLast = introducedLast;
        this.history = history;
    }

    /**
     * Matches the input.
     *
     * @param input      the input
     * @param strictness the strictness
     * @return the match, or empty if nothing matches
     */
    public Optional<Match<T>> match(String input, Strictness strictness) {
        Objects.requireNonNull(input, field);
        Objects.requireNonNull(strictness, "strictness");
        EnumSet<Relaxation> observed = EnumSet.noneOf(Relaxation.class);
        String s = input;

        if (strictness.allows(Relaxation.WHITESPACE)) {
            String trimmed = trimWhiteSpace(s);
            if (!trimmed.equals(s)) {
                observed.add(Relaxation.WHITESPACE);
                s = trimmed;
            }
        }
        if (strictness.allows(Relaxation.DASH)) {
            String dashed = normaliseDashes(s);
            if (!dashed.equals(s)) {
                observed.add(Relaxation.DASH);
                s = dashed;
            }
        }
        if (strictness.allows(Relaxation.NUMERIC_PADDING) && numeric && isShortAsciiNumber(s)) {
            s = "0".repeat(3 - s.length()) + s;
            observed.add(Relaxation.NUMERIC_PADDING);
        }

        boolean allowWithdrawn = strictness.allows(Relaxation.WITHDRAWN);
        // Exact comparison against every candidate first; an active entry wins over a withdrawn one.
        T entry = active.get(s);
        if (entry == null && allowWithdrawn && (entry = withdrawn.get(s)) != null) {
            observed.add(Relaxation.WITHDRAWN);
        }
        if (entry == null && strictness.allows(Relaxation.ASCII_CASE)) {
            String folded = asciiUpper(s);
            entry = activeFolded.get(folded);
            if (entry == null && allowWithdrawn && (entry = withdrawnFolded.get(folded)) != null) {
                observed.add(Relaxation.WITHDRAWN);
            }
            if (entry != null) {
                observed.add(Relaxation.ASCII_CASE);
            }
        }
        return entry == null ? Optional.empty() : Optional.of(new Match<>(entry, observed, Optional.empty()));
    }

    /**
     * Matches the input and checks the match against history.
     *
     * @param input      the input
     * @param strictness the strictness
     * @param writtenAt  when the value was written
     * @param policy     when the history check passes
     * @return the match, with its history check, or empty if nothing matches today
     */
    public Optional<Match<T>> match(String input, Strictness strictness, LocalDate writtenAt, HistoryPolicy policy) {
        Objects.requireNonNull(writtenAt, "writtenAt");
        Objects.requireNonNull(policy, "history");
        if (history == null) {
            throw new UnsupportedOperationException("No history for " + field);
        }
        return match(input, strictness).map(m -> {
            Set<HistoryState> states = Timeline.parse(history.timeline(m.entry()), introducedFirst)
                    .statesAt(writtenAt, history.recordedSince(m.entry()), introducedFirst, introducedLast);
            return new Match<>(m.entry(), m.relaxations(),
                    Optional.of(new HistoryCheck(writtenAt, states, policy, policy.passes(states))));
        });
    }

    /**
     * The exception to throw when nothing matches.
     *
     * @param input      the input
     * @param strictness the strictness
     * @return the exception
     */
    public UnknownCodeException unknown(String input, Strictness strictness) {
        return new UnknownCodeException(standard, field, input, strictness);
    }

    /**
     * The exception to throw when a match's history check failed.
     *
     * @param input      the input
     * @param strictness the strictness
     * @param match      the match whose check failed
     * @return the exception
     */
    public MeaningChangedException meaningChanged(String input, Strictness strictness, Match<T> match) {
        return new MeaningChangedException(standard, field, input, strictness, match.entry(), match.history().orElseThrow());
    }

    /**
     * Whether a match passes, i.e. has no failed history check.
     *
     * @param match the match
     * @return true if it passes
     */
    public static boolean passes(Match<?> match) {
        return match.history().map(HistoryCheck::passed).orElse(true);
    }

    /** Unicode White_Space, which differs from {@link Character#isWhitespace} (e.g. it includes U+00A0). */
    private static boolean isWhiteSpace(int cp) {
        return (cp >= 0x09 && cp <= 0x0D) || cp == 0x20 || cp == 0x85 || cp == 0xA0 || cp == 0x1680
                || (cp >= 0x2000 && cp <= 0x200A) || cp == 0x2028 || cp == 0x2029 || cp == 0x202F || cp == 0x205F
                || cp == 0x3000;
    }

    private static String trimWhiteSpace(String s) {
        int start = 0;
        int end = s.length();
        while (start < end && isWhiteSpace(s.codePointAt(start))) {
            start += Character.charCount(s.codePointAt(start));
        }
        while (end > start && isWhiteSpace(s.codePointBefore(end))) {
            end -= Character.charCount(s.codePointBefore(end));
        }
        return s.substring(start, end);
    }

    private static String normaliseDashes(String s) {
        StringBuilder out = new StringBuilder(s.length());
        s.codePoints().forEach(cp -> out.appendCodePoint(switch (cp) {
            case 0x2010, 0x2011, 0x2012, 0x2013, 0x2014, 0x2015, 0x2212, 0xFE58, 0xFE63, 0xFF0D -> '-';
            default -> cp;
        }));
        return out.toString();
    }

    private static boolean isShortAsciiNumber(String s) {
        if (s.isEmpty() || s.length() > 2) {
            return false;
        }
        for (int i = 0; i < s.length(); i++) {
            if (s.charAt(i) < '0' || s.charAt(i) > '9') {
                return false;
            }
        }
        return true;
    }

    /** Upper-cases ASCII letters only, independent of locale. */
    private static String asciiUpper(String s) {
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            if (chars[i] >= 'a' && chars[i] <= 'z') {
                chars[i] = (char) (chars[i] - 'a' + 'A');
            }
        }
        return new String(chars);
    }
}
