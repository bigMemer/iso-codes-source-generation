package __PACKAGE__;

import java.util.Objects;
import java.util.Optional;

/**
 * The detailed result of a validity check.
 *
 * @param isValid whether the input is valid: it matches, and its history check (if any) passed
 * @param match   the match, present whenever the code matches today, even if the history check failed
 * @param <T>     the entry type
 */
public record Validation<T>(boolean isValid, Optional<Match<T>> match) {

    /**
     * Creates a validation result.
     *
     * @param isValid whether the input is valid
     * @param match   the match, if any
     */
    public Validation {
        Objects.requireNonNull(match, "match");
        boolean passes = match.isPresent() && match.get().history().map(HistoryCheck::passed).orElse(true);
        if (isValid != passes) {
            throw new IllegalArgumentException("isValid must be true exactly when there is a passing match");
        }
    }
}
